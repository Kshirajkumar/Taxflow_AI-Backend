# Render environment variables for TaxFlow backend.
# Replace every <...> value before importing this file into Render.
# Never commit a filled-in copy. Never share this file after adding secrets.

NODE_ENV=production

# Supabase PostgreSQL connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=<SUPABASE_DATABASE_URL>

# TaxFlow ownership values.
# TAXFLOW_FIRM_ID is your firm/workspace UUID.
TAXFLOW_FIRM_ID=637a6e11-0fc2-49c5-ab73-e9670bd25b49
# TAXFLOW_CLIENT_USER_ID is the Supabase Auth user UUID that owns public.clients.
TAXFLOW_CLIENT_USER_ID=11752602-62fa-4252-ae1d-23c4fb3b7312

# Used by the desktop app when it calls the backend.
TAXFLOW_API_TOKEN=<GENERATED_TAXFLOW_API_TOKEN>

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTAKE_ENCRYPTION_KEY=<GENERATED_BASE64_32_BYTE_KEY>

# Gemini extraction configuration.
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.5-flash

# Private Supabase Storage configuration.
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_BUCKET=taxflow-intake

# Telegram Bot API configuration. Keep both values server-side on Render.
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=<TELEGRAM_WEBHOOK_SECRET>
# Optional for testing with a compatible Bot API mock; omit in production.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Render supplies PORT automatically; do not add a fixed PORT.

# Files are encrypted and stored in Supabase Storage in cloud deployment.
INTAKE_SPOOL_PATH=/tmp/taxflow-intake-spool
EXTRACTION_STAGING_PATH=/tmp/taxflow-staging

# Maximum inbound Telegram/document request size: 25 MB.
MAX_INTAKE_BYTES=26214400

# Desktop development origin. Add your deployed frontend origin later if needed.
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
